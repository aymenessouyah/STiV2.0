    {
      "titre": "Mission 5 — Le tri du vendeur",
      "enonce": "Ignorer les articles de prix inférieur à 40 et afficher les vendeurs dont le CA dépasse 500.",
      "jointure": {
        "sql": "SELECT ve.nom, SUM(v.quantite * v.prix_unitaire) AS ca\nFROM VENDEUR ve, VENTE v\nWHERE ve.id_vendeur = v.id_vendeur\nAND v.prix_unitaire >= 40\nGROUP BY ve.id_vendeur, ve.nom\nHAVING SUM(v.quantite * v.prix_unitaire) > 500;",
