    {
      "titre": "Mission 3 — Les vendeurs performants",
      "enonce": "Afficher les vendeurs dont le CA dépasse 700.",
      "jointure": {
        "sql": "SELECT ve.nom, SUM(v.quantite * v.prix_unitaire) AS ca\nFROM VENDEUR ve, VENTE v\nWHERE ve.id_vendeur = v.id_vendeur\nGROUP BY ve.id_vendeur, ve.nom\nHAVING SUM(v.quantite * v.prix_unitaire) > 700;",
        "resultat": {
          "colonnes": [
            "nom",
            "ca"
          ],
          "lignes": [
            [
              "Sana",
              1045
            ],
            [
              "Karim",
              766
            ]
          ]
        }
      },
      "sous_requete": {
        "sql": "SELECT nom\nFROM VENDEUR\nWHERE id_vendeur IN (\n    SELECT id_vendeur\n    FROM VENTE\n    GROUP BY id_vendeur\n    HAVING SUM(quantite * prix_unitaire) > 700\n);",
        "resultat": {
          "colonnes": [
            "nom"
          ],
          "lignes": [
            [
              "Sana"
            ],
            [
              "Karim"
            ]
          ]
        }
      },
      "remarque": "Mêmes vendeurs ; les colonnes diffèrent : IN ne renvoie que les noms."
    },
    {
      "titre": "Mission 4 — Les polyvalents",
      "enonce": "Afficher les vendeurs ayant vendu dans au moins 3 catégories différentes.",
      "jointure": {
        "sql": "SELECT ve.nom, COUNT(DISTINCT v.categorie) AS nb_rayons\nFROM VENDEUR ve, VENTE v\nWHERE ve.id_vendeur = v.id_vendeur\nGROUP BY ve.id_vendeur, ve.nom\nHAVING COUNT(DISTINCT v.categorie) >= 3;",
        "resultat": {
