<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>STI-Labo3-Installation</AssemblyName>
    <Product>STI v2.0 version spéciale Labo 3</Product>
    <Title>STI v2.0 version spéciale Labo 3</Title>
    <Description>Installation hors ligne Labo 3 — version candidate</Description>
    <ApplicationIcon>../../assets/icons/STI_by_AE.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <!-- Publication autonome fournie par compiler.ps1 : -r win-x64 --self-contained PublishSingleFile -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="../../assets/icons/sti-logo-complet.png" LogicalName="STILabo3.Logo.png" />
    <EmbeddedResource Include="../../assets/icons/STI_by_AE.ico" LogicalName="STILabo3.Icon.ico" />
    <EmbeddedResource Include="$(Labo3PublicKey)" LogicalName="STILabo3.PublicKey.pem" Condition="'$(Labo3PublicKey)' != ''" />
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
  </ItemGroup>
</Project>
